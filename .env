# TravelDesk Mobile App Environment Variables
# Expo automatically loads variables prefixed with EXPO_PUBLIC_

# Backend API Endpoint
EXPO_PUBLIC_API_URL=http://localhost:8080/api

# Optional Android override:
# - For Android Emulator: "localhost" is automatically remapped to 10.0.2.2:8080/api
# - For Physical Device over Wi-Fi: uncomment and set your Mac's IP (e.g., 192.168.31.152)
# EXPO_PUBLIC_API_URL_ANDROID=http://192.168.31.152:8080/api

# App Environment
EXPO_PUBLIC_APP_ENV=development

