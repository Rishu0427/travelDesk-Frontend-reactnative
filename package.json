{
  "name": "traveldesk-mobileapp-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "TravelDesk React Native + Next.js TypeScript Monorepo",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "start": "npm run start --workspace=@traveldesk/mobile",
    "web": "npm run web --workspace=@traveldesk/mobile",
    "android": "npm run android --workspace=@traveldesk/mobile",
    "ios": "npm run ios --workspace=@traveldesk/mobile",
    "build:web": "npm --prefix apps/mobile run build -- -p web",
    "check": "npm run check --workspace=@traveldesk/mobile"
  },
  "devDependencies": {
    "tsx": "^4.23.15"
  }
}
